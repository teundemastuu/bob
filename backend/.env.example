# Copy to .env and fill in your own values.

# PostgreSQL connection string.
# Matches the credentials in docker-compose.yml when running via Docker.
DATABASE_URL=postgresql+psycopg://app:app@db:5432/process_hitl

# Key used to sign JWT access tokens. Required. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# OpenAI model used for every LLM step: protocol generation (P1), interviewing
# (P2), inconsistency and knowledge gap detection (P3), consolidation (P4) and
# BPMN model generation (P5).
OPENAI_MODEL=gpt-5-mini-2025-08-07

# Fernet key used to encrypt the OpenAI API key that an analyst stores in their
# account. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If unset, a key is derived from SECRET_KEY.
OPENAI_KEY_ENCRYPTION_KEY=

# BPMN layout service (see README). Use host.docker.internal when the backend
# runs in Docker and the layout service runs on the host.
BPMN_GENERATOR_URL=http://host.docker.internal:8098
